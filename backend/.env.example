# Local dev: the docker-compose Postgres. Deployed: a Neon connection string
# (postgresql://<user>:<pw>@<host>.neon.tech/<db>?sslmode=require) - set
# SKIP_DB_AUTOCREATE=true there since the app can't CREATE DATABASE on Neon.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/booktures
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=booktures
SKIP_DB_AUTOCREATE=false

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
MAX_UPLOAD_MB=25

# Required in any public deployment - unset means no auth (fine for local dev only).
# Frontend must send the same value as VITE_API_KEY.
APP_API_KEY=

# OLLAMA_ENABLED gates *Ollama only*. LLM enrichment (page summaries, image-prompt
# rewriting, OCR repair, header/footer + weak-text classification) still runs when
# LLM_PROVIDER is a cloud provider (groq/gemini), regardless of this flag.
OLLAMA_ENABLED=True

# LLM_PROVIDER: ollama (local), groq, or gemini. Also switchable at runtime on the
# Settings page (writes the DB-backed settings table, no restart).
LLM_PROVIDER=ollama
# OLLAMA_BASE_URL: any reachable Ollama. For the hosted backend to use a local
# Ollama it must be a public tunnel URL (ngrok/cloudflared), not localhost.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
OLLAMA_FAST_MODEL=phi3
OLLAMA_TIMEOUT_SECONDS=180
# GROQ_API_KEY=
# Groq retired the Llama 3.x hosted models. Current fast free-tier option:
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Character extraction:
#   CHARACTER_EXTRACTION_MODE: spacy (NER, needs en_core_web_sm) or llm (single pass, no spaCy)
#   CHARACTER_LLM_PROVIDER: provider for the whole-book character pass, independent of
#     LLM_PROVIDER. Defaults to "gemini" for its large context (needs GEMINI_API_KEY);
#     falls back to LLM_PROVIDER if that provider returns nothing. Set "" to disable.
#   CHARACTER_LLM_MAX_CHARS: chars of the book sent per pass when the provider is gemini.
CHARACTER_EXTRACTION_MODE=llm
# CHARACTER_LLM_PROVIDER=gemini
# CHARACTER_LLM_MAX_CHARS=120000
# Character extraction raises (job fails visibly) if it finds zero characters.
# Set true only for texts that genuinely have no named characters.
# CHARACTER_EXTRACTION_ALLOW_EMPTY=false

# OCR (Tesseract) tuning - lower DPI + capped LLM repair keeps memory and cloud
# rate-limit usage sane on small instances.
# OCR_DPI=200
# OCR_REPAIR_MAX_CHUNKS_PER_PAGE=3
# OCR_REPAIR_MAX_CALLS=40

# IMAGE_PROVIDER:
#   diffusers     local GPU/CPU (default)
#   workers-ai    Cloudflare Workers AI - genuinely free tier, ~7s/image, SDXL (recommended cloud)
#   pollinations  keyless, no signup, lower quality - good fallback
#   gemini        Gemini 2.5 Flash Image - good quality + reference images, but NOT free
#                 (image model free-tier quota is 0; needs billing on the Google project)
IMAGE_PROVIDER=diffusers
IMAGE_PRESET=balanced
DIFFUSION_MODEL=segmind/SSD-1B
IMAGE_WIDTH=768
IMAGE_HEIGHT=768
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# CF_WORKERS_AI_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image   # GEMINI_API_KEY is set in the LLM section above

# STORAGE_PROVIDER: local (default), nhost, or r2
STORAGE_PROVIDER=local
# Nhost Storage (STORAGE_PROVIDER=nhost). The `default` bucket must allow public
# downloads - give the `public` role Download access on storage.files.
# NHOST_STORAGE_URL=https://jhowkmqddbkqwgwbjrek.storage.ap-south-1.nhost.run/v1
# NHOST_ADMIN_SECRET=
# NHOST_BUCKET=default
# Cloudflare R2 (STORAGE_PROVIDER=r2).
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=
